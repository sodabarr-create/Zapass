# Скопируйте в .env на сервере. Не загружайте .env в GitHub.
DOMAIN=zapas.example.com
ZAPAS_WEB_ORIGIN=https://zapas.example.com
ZAPAS_ENV=production
ZAPAS_DATA_DIR=/data
# Сгенерируйте: python scripts/generate_key.py (не публикуйте результат)
ZAPAS_MASTER_KEY=
TELEGRAM_BOT_TOKEN=
# Числовой ID владельца, не @username
TELEGRAM_CHAT_ID=
ZAPAS_BOT_ENABLED=1
# Платежи выключены. Не включайте до проверки реального эквайринга.
ZAPAS_SBP_ENABLED=0
ZAPAS_PRICE_APPROVED=0
